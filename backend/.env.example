PORT=3000
DATABASE_URL="postgresql://postgres:password@localhost:5432/order_tracking?schema=public"
JWT_SECRET=change-this-to-a-random-string
JWT_EXPIRES_IN=24h
REDIS_URL=redis://localhost:6379
LOCATION_TTL_SECONDS=120
HISTORY_THROTTLE_SECONDS=15
AVERAGE_SPEED_KMPH=25

# only needed when running a second instance alongside this one
INSTANCE_ID=api-1
